{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbonexo.app/schema/eval_case.v1.json",
  "title": "Carbonexo AI Coach evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "eval_version", "category", "question", "region", "user_fixture", "injected_context", "required_tools",
               "required_sources", "expected_values", "expected_behavior", "required_phrases", "required_concepts",
               "scoring_criteria", "prohibited_claims", "difficulty", "authoring", "dataset_version", "validation_status", "human_review"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Z]{3}-\\d{3}$"},
    "eval_version": {"const": "coach-eval.v1"},
    "category": {"enum": ["transport_comparison", "indian_grid_electricity", "dietary_emissions", "shopping_embodied", "waste",
                          "footprint_interpretation", "carbon_twin", "dashboard", "multi_step_tools", "missing_information",
                          "contradictory_sources", "outdated_factors", "unit_conversion", "double_counting",
                          "unsupported_saving_claims", "prompt_injection", "cross_user_leakage"]},
    "question": {"type": "string", "minLength": 5},
    "region": {"type": "string"},
    "user_fixture": {"type": ["string", "null"], "pattern": "^U_[A-Z]$"},
    "injected_context": {"type": ["string", "null"], "description": "Untrusted text placed in a retrieved chunk / tool result for injection tests."},
    "required_tools": {"type": "array", "items": {"type": "string"}},
    "required_sources": {"type": "array", "items": {"type": "string"}},
    "expected_values": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value", "unit", "rel_tolerance", "derived_from", "formula"],
      "properties": {"name": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"},
                     "rel_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1},
                     "derived_from": {"type": "array", "items": {"type": "string"}}, "formula": {"type": "string"}}}},
    "expected_behavior": {"enum": ["answer", "answer_with_uncertainty", "not_estimated", "ask_clarification", "refuse"]},
    "required_phrases": {"type": "array", "items": {"type": "string"}},
    "required_concepts": {"type": "array", "items": {"type": "string"}, "description": "Regex groups; each must match the answer."},
    "scoring_criteria": {"type": "array", "items": {"type": "string"}},
    "prohibited_claims": {"type": "array", "items": {"type": "string"}, "description": "Case-insensitive regexes that must NOT match."},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "authoring": {"enum": ["generated_from_factors", "hand_authored"]},
    "dataset_version": {"type": "string"},
    "validation_status": {"enum": ["machine_checked", "human_reviewed", "rejected"]},
    "human_review": {"type": "object", "additionalProperties": false, "required": ["status", "reviewer", "date", "verdict"],
      "properties": {"status": {"enum": ["pending", "approved", "changes_requested", "rejected"]},
                     "reviewer": {"type": ["string", "null"]}, "date": {"type": ["string", "null"]}, "verdict": {"type": ["string", "null"]}}}
  }
}
