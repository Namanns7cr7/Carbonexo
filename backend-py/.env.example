# Copy to .env and fill in for local dev. Every var mirrors application.yml's
# ${VAR:default} exactly — see app/config.py.

DB_URL=jdbc:postgresql://localhost:5432/ecotrack
DB_USER=ecotrack
DB_PASSWORD=ecotrack
DB_POOL_MAX=10

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

JWT_SECRET=change-me-dev-only-secret-change-me-dev-only-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
JWT_ISSUER=ecotrack

GOOGLE_CLIENT_ID=

STORAGE_PROVIDER=local_stub
GCP_PROJECT_ID=
GCS_BUCKET=carbonexo-bills
STORAGE_LOCAL_DIR=./.local-blob

UPLOAD_MAX_BYTES=10485760

OCR_PROVIDER=tesseract
TESSDATA_PREFIX=

CARBON_ELECTRICITY_FACTOR=0.45

# AI_PROVIDER defaults to "canned" in this Phase-1 pass (Gemini is a stub) —
# see app/config.py and app/ai/factory.py for why this differs from the Java
# default of "gemini".
AI_PROVIDER=canned
AI_DEFAULT_MODEL=gemini-2.5-pro
AI_FAST_MODEL=gemini-2.0-flash
AI_TIMEOUT=30
AI_FALLBACK=true
GCP_LOCATION=us-central1

LOG_LEVEL=INFO
LOG_LEVEL_APP=DEBUG

# Only used by pytest for tests that genuinely need Postgres features
# (gen_random_uuid/jsonb/triggers) — leave unset to skip those cleanly.
TEST_DATABASE_URL=
